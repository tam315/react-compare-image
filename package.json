{
  "name": "react-compare-image",
  "version": "3.5.23",
  "description": "React component to compare two images using slider.",
  "main": "./dist/ReactCompareImage.umd.js",
  "module": "./dist/ReactCompareImage.mjs",
  "types": "./dist/ReactCompareImage.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ReactCompareImage.d.ts",
      "require": "./dist/ReactCompareImage.umd.js",
      "import": "./dist/ReactCompareImage.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build && npm run test:dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --browser.headless",
    "test:dist": "node scripts/smoke-test-dist.mjs",
    "test:ui": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "tam315/react-compare-image"
  },
  "author": "Shota Tamura",
  "license": "MIT",
  "peerDependencies": {
    "react": "^16.8 || ^17 || ^18 || ^19",
    "react-dom": "^16.8 || ^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/resize-observer-browser": "^0.1.11",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2",
    "vitest-browser-react": "^2.3.0"
  },
  "keywords": [
    "picture comparison",
    "image comparison",
    "slider",
    "react",
    "twentytwenty"
  ],
  "browserslist": [
    "last 1 Chrome versions",
    "last 1 Safari versions",
    "last 1 Firefox versions",
    "last 1 Edge versions",
    "last 1 ChromeAndroid versions",
    "last 1 iOS versions"
  ],
  "allowScripts": {
    "esbuild": false
  }
}
